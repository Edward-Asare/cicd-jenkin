# Local development
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/storetrack
ADMIN_USERNAME=admin
# Development-only plaintext password. Production requires ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=replace-with-a-local-password

# Production secrets
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Set true only when intentionally allowing the demo seed endpoint in production.
ALLOW_DEMO_SEED=false
